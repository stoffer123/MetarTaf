@page "/airport/{icao}"
@using DecoderTesting
@rendermode InteractiveServer

<PageTitle>@icao - @(airport?.country ?? "Unknown")</PageTitle>

<h3>Details for Airport: @(icao ?? "Not Provided")</h3>

@if (airport == null)
{
    <p>Loading airport data...</p>
}
else
{
    <dl>
        <dt>ICAO:</dt>
        <dd>@airport.icaoId</dd>
        <dt>IATA:</dt>
        <dd>@airport.iataId</dd>
        <dt>Country:</dt>
        <dd>@airport.country</dd>
        <dt>State:</dt>
        <dd>@airport.state</dd>
        <dt>Site:</dt>
        <dd>@airport.site</dd>
        <dt>Latitude:</dt>
        <dd>@airport.lat</dd>
        <dt>Longitude:</dt>
        <dd>@airport.lon</dd>
    </dl>
}

@code {
    [Parameter] public string? icao { get; set; }
    private Airport? airport;

    // Inject AirportFactory as a dependency
    [Inject] private AirportFactory AirportFactory { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(icao))
        {
            try
            {
                airport = AirportFactory.getAirport(icao);
            }
            catch (KeyNotFoundException)
            {
                Console.WriteLine($"Airport with ICAO {icao} not found.");
            }
        }
    }
}