@page "/Overview"
@using Metar.Decoder.Entity
@using MetarTaf_Backend.Models
@using Microsoft.AspNetCore.Components.Web.Extensions
@using System.Text.Json
@using Taf.Decoder.entity
@implements IDisposable
@rendermode InteractiveServer

@inject NavigationManager Navigation

<PageTitle>Airport overview</PageTitle>

<div>
    <p>Current time: @currentTime.ToString("yyyy-MM-dd HH:mm:ss")z</p>
</div>

<div class="top-menu">
    <EditForm Model="newAirportModel" OnValidSubmit="AddAirport">
        <InputText @bind-Value="newAirportModel.Icao" placeholder="Enter ICAO code" @oninput="@(e => newAirportModel.Icao = e.Value?.ToString()?.ToUpper() ?? string.Empty)" />
        <button type="submit">Add Airport</button>
        <button @onclick="ConfirmAllReports">Acknowledge all changes</button>
        <button class="clearall-button" @onclick="@(async () => { if (await JSRuntime.InvokeAsync<bool>("confirmClearAllAirports")) { await ClearAllAirports(); } })">Clear All Airports</button>

        <div>
            last acknowledge: @lastAcknowledgeTime.ToString("HH:mm:ss")
        </div>

        <label>
            <InputCheckbox @bind-Value="showNewTaf" /> Show TAF updates
        </label>
        <label>
            <InputCheckbox @bind-Value="showNewMetar" /> Show METAR updates
        </label>

    </EditForm>

</div>

@foreach (var airport in airports)
{
    // Get the latest METAR and TAF reports
    MetarReport latestMetar = airport.getMetars().OrderByDescending(m => m.Key).FirstOrDefault().Value;
    TafReport latestTaf = airport.getTafs().OrderByDescending(t => t.Key).FirstOrDefault().Value;

    // Default to UTC now if the reportTime is not available
    DateTime metarTime = latestMetar != null && latestMetar.reportTime != null
        ? latestMetar.reportTime
        : DateTime.UtcNow;

    DateTime lastMetarFetch = latestMetar != null && latestMetar.fetchTime != null
        ? latestMetar.fetchTime
        : DateTime.UtcNow;


    TimeSpan timeSinceLastMetar = currentTime - metarTime;
    TimeSpan metarTimeDifference = lastMetarFetch - metarTime;

    DateTime tafTime = latestTaf != null && latestTaf.reportTime != null
        ? latestTaf.reportTime
        : DateTime.UtcNow;

    DateTime lastTafFetch = latestTaf != null && latestTaf.fetchTime != null
        ? latestTaf.fetchTime
        : DateTime.UtcNow;

    TimeSpan timeSinceLastTAF = currentTime - tafTime;
    TimeSpan tafTimeDifference = lastTafFetch - tafTime;


    <div>
        <table class="table-parent">
            <thead>
                <tr>
                    <th></th>
                    <th>Station</th>
                    <th>Report type</th>
                    <th>Report time</th>
                    <th>Fetch Time</th>
                    <th>Raw report</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="actions-cell" rowspan="2">
                        <button @onclick="() => ConfirmReports(airport)" title="Confirm reports">
                            ✔️
                        </button>
                        <button @onclick="() => RemoveAirport(airport.getAirportInfo().icaoId)" title="Remove airport">
                            ❌
                        </button>
                    </td>
                    <td class="station-cell" rowspan="2" @onclick="() => NavigateToAirportPage(airport.getAirportInfo().icaoId)">
                        <div style="display: flex; flex-direction: column; justify-content: space-between; height: 100%;">
                            <div>
                                @airport.getAirportInfo().icaoId
                            </div>
                            <div class="station-city">
                                @airport.getAirportInfo().country
                            </div>
                        </div>
                    </td>

                    @if (latestTaf != null)
                    {
                        <td class="report-type-cell @((airport.getIsNewTaf() && showNewTaf ? "taf-new-report" : "taf-old-report"))">
                            TAF
                        </td>
                        <td class="reports-time-cell @((airport.getIsNewTaf() && showNewTaf ? "taf-new-report" : "taf-old-report"))">
                            @tafTime.ToString("HH:mm") (@timeSinceLastTAF.ToString(@"hh\:mm"))
                        </td>
                        <td class="reports-time-cell @((airport.getIsNewTaf() && showNewTaf ? "taf-new-report" : "taf-old-report"))">
                            @lastTafFetch.ToString("HH:mm") (@tafTimeDifference.ToString(@"hh\:mm"))
                        </td>
                        <td class="@((airport.getIsNewTaf() && showNewTaf ? "taf-new-report" : "taf-old-report"))">
                            @latestTaf.decodedTaf?.RawTaf
                        </td>
                    }
                    else
                    {
                        <td class="report-type-cell">TAF</td>
                        <td class="reports-time-cell">NO TAF</td>
                        <td class="reports-time-cell">NO TAF</td>
                        <td class="taf-old-report">NO TAF</td>
                    }
                </tr>

                <tr>
                    @if (latestMetar != null)
                    {
                        <td class="report-type-cell @((airport.getIsNewMetar() && showNewMetar ? "metar-new-report" : "metar-old-report"))">
                            METAR
                        </td>
                        <td class="reports-time-cell @((airport.getIsNewMetar() && showNewMetar ? "metar-new-report" : "metar-old-report"))">
                            @metarTime.ToString("HH:mm") (@timeSinceLastMetar.ToString(@"hh\:mm"))
                        </td>
                        <td class="reports-time-cell @((airport.getIsNewMetar() && showNewMetar ? "metar-new-report" : "metar-old-report"))">
                            @lastMetarFetch.ToString("HH:mm") (@metarTimeDifference.ToString(@"hh\:mm"))
                        </td>
                        <td class="@((airport.getIsNewMetar() && showNewMetar ? "metar-new-report" : "metar-old-report"))">
                            @latestMetar.decodedMetar?.RawMetar
                        </td>
                    }
                    else
                    {
                        <td class="report-type-cell">METAR</td>
                        <td class="reports-time-cell">NO METAR</td>
                        <td class="reports-time-cell">NO METAR</td>
                        <td class="metar-old-report">NO METAR</td>
                    }
                </tr>
            </tbody>
        </table>
    </div>
}



