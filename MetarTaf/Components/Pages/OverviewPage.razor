@page "/Overview"
@implements IDisposable
@rendermode InteractiveServer

@inject NavigationManager Navigation

<PageTitle>Airport overview</PageTitle>

<div>
    <p>Current time: @currentTime.ToString("yyyy-MM-dd HH:mm:ss")z</p>
</div>

<div class="top-menu">
    <EditForm Model="newAirportModel" OnValidSubmit="AddAirport">
        <InputText @bind-Value="newAirportModel.Icao" placeholder="Enter ICAO code" @oninput="@(e => newAirportModel.Icao = e.Value?.ToString()?.ToUpper() ?? string.Empty)" />
        <button type="submit">Add Airport</button>
        <button @onclick="ConfirmAllReports">Acknowledge all changes</button>
        <button class="clearall-button" @onclick="@(async () => { if (await JSRuntime.InvokeAsync<bool>("confirmClearAllAirports")) { await ClearAllAirports(); } })">Clear All Airports</button>

        <div>
            last acknowledge: @lastAcknowledgeTime.ToString("HH:mm:ss")
        </div>

        <label>
            <InputCheckbox @bind-Value="showNewTaf" /> Show TAF updates
        </label>
        <label>
            <InputCheckbox @bind-Value="showNewMetar" /> Show METAR updates
        </label>

    </EditForm>

</div>

@foreach (var ap in airports)
{
    var nowUtc = currentTime;
    var nowClock = nowUtc.TimeOfDay;

    // METAR
    var m = ap.LatestMetar;
    var metarReportAge = TimeSpan.Zero;
    var metarFetchDiff = TimeSpan.Zero;
    if (m != null)
    {
        metarReportAge = nowClock - m.ReportTimeUtc.TimeOfDay;
        metarFetchDiff = m.FetchTimeUtc.TimeOfDay - m.ReportTimeUtc.TimeOfDay;
    }

    // TAF
    var t = ap.LatestTaf;
    var tafReportAge = TimeSpan.Zero;
    var tafFetchDiff = TimeSpan.Zero;
    if (t != null)
    {
        tafReportAge = nowClock - t.ReportTimeUtc.TimeOfDay;
        tafFetchDiff = t.FetchTimeUtc.TimeOfDay - t.ReportTimeUtc.TimeOfDay;
    }

    // “ny” pr. bruger (AckTracker)
    bool metarIsNewForUser = m != null && ack.IsMetarNew(ap.Icao, m.ReportTimeUtc);
    bool tafIsNewForUser = t != null && ack.IsTafNew(ap.Icao, t.ReportTimeUtc);

    // lyd på AMD + ny
    if (t != null && t.IsAmd && tafIsNewForUser)
    {
        _ = JSRuntime.InvokeVoidAsync("playAmdAlert");
    }

    var tafRowClass =
        (t != null && tafIsNewForUser && showNewTaf)
        ? (t.IsAmd ? "blink-red" : "taf-new-report")
        : "taf-old-report";

    <div>
        <table class="table-parent">
            <thead>
                <tr>
                    <th></th>
                    <th>Station</th>
                    <th>Report type</th>
                    <th>Report time(age)</th>
                    <th>Fetch time(age)</th>
                    <th>Raw report</th>
                </tr>
            </thead>
            <tbody>
                <tr class="@tafRowClass">
                    <td class="actions-cell" rowspan="2">
                        <button @onclick="() => ConfirmReports(ap)" title="Confirm reports">✔️</button>
                        <button @onclick="() => RemoveAirport(ap.Icao)" title="Remove airport">❌</button>
                    </td>

                    <td class="station-cell" rowspan="2" @onclick="() => NavigateToAirportPage(ap.Icao)">
                        <div style="display:flex;flex-direction:column;justify-content:space-between;height:100%;">
                            <div>@ap.Icao</div>
                            <div class="station-city">@ap.Country</div>
                        </div>
                    </td>

                    @if (t != null)
                    {
                        <td>@t.Type</td>
                        <td>@t.ReportTimeUtc.ToString("HH:mm") (@FormatTimeDiff(tafReportAge))</td>
                        <td>@t.FetchTimeUtc.ToString("HH:mm") (@FormatTimeDiff(tafFetchDiff))</td>
                        <td>@t.Raw</td>
                    }
                    else
                    {
                        <td>TAF</td>
                        <td>NO TAF</td>
                        <td>NO TAF</td>
                        <td>NO TAF</td>
                    }
                </tr>

                <tr>
                    @if (m != null)
                    {
                        var metarClass = (metarIsNewForUser && showNewMetar) ? "metar-new-report" : "metar-old-report";
                        <td class="report-type-cell @metarClass">@m.Type</td>
                        <td class="reports-time-cell @metarClass">@m.ReportTimeUtc.ToString("HH:mm") (@FormatTimeDiff(metarReportAge))</td>
                        <td class="reports-time-cell @metarClass">@m.FetchTimeUtc.ToString("HH:mm") (@FormatTimeDiff(metarFetchDiff))</td>
                        <td class="@metarClass">@m.Raw</td>
                    }
                    else
                    {
                        <td class="metar-old-report">METAR</td>
                        <td class="metar-old-report">NO METAR</td>
                        <td class="metar-old-report">NO METAR</td>
                        <td class="metar-old-report">NO METAR</td>
                    }
                </tr>
            </tbody>
        </table>
    </div>
}



