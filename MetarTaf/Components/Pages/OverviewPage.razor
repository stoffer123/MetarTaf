@page "/Overview"
@using Metar.Decoder.Entity
@using MetarTaf_Backend.Models
@using Microsoft.AspNetCore.Components.Web.Extensions
@using System.Text.Json
@using Taf.Decoder.entity
@using MetarTaf_Backend.Utils
@implements IDisposable
@rendermode InteractiveServer

@inject NavigationManager Navigation

<PageTitle>Airport overview</PageTitle>

<div>
    <p>Current time: @currentTime.ToString("yyyy-MM-dd HH:mm:ss")z</p>
</div>

<div class="top-menu">
    <EditForm Model="newAirportModel" OnValidSubmit="AddAirport">
        <InputText @bind-Value="newAirportModel.Icao" placeholder="Enter ICAO code" @oninput="@(e => newAirportModel.Icao = e.Value?.ToString()?.ToUpper() ?? string.Empty)" />
        <button type="submit">Add Airport</button>
        <button @onclick="ConfirmAllReports">Acknowledge all changes</button>
        <button class="clearall-button" @onclick="@(async () => { if (await JSRuntime.InvokeAsync<bool>("confirmClearAllAirports")) { await ClearAllAirports(); } })">Clear All Airports</button>

        <div>
            last acknowledge: @lastAcknowledgeTime.ToString("HH:mm:ss")
        </div>

        <label>
            <InputCheckbox @bind-Value="showNewTaf" /> Show TAF updates
        </label>
        <label>
            <InputCheckbox @bind-Value="showNewMetar" /> Show METAR updates
        </label>

    </EditForm>

</div>

@foreach (var airport in airports)
{
    DateTime nowUtc = currentTime; // du bruger allerede UTC
	TimeSpan nowClock = nowUtc.TimeOfDay;

    // METAR
    MetarReport latestMetar = airport.getMetars().OrderByDescending(m => m.Key).FirstOrDefault().Value;
    DateTime metarReportUtc;
    DateTime metarFetchUtc;
    TimeSpan metarReportAge = TimeSpan.Zero;
    TimeSpan metarFetchDiff = TimeSpan.Zero;

    if (latestMetar != null)
    {
        metarReportUtc = DateTime.SpecifyKind(latestMetar.reportTime, DateTimeKind.Utc);
        metarFetchUtc = DateTime.SpecifyKind(latestMetar.fetchTime, DateTimeKind.Utc);
        metarReportAge = nowClock - metarReportUtc.TimeOfDay;
        metarFetchDiff = metarFetchUtc.TimeOfDay - metarReportUtc.TimeOfDay; // kan være negativ (hentet før “officiel” tid)

    }
    else
    {
        metarReportUtc = DateTime.MinValue; // eller en anden passende værdi
        metarFetchUtc = DateTime.MinValue; // eller en anden passende værdi
    }

    // TAF
    TafReport latestTaf = airport.getTafs().OrderByDescending(t => t.Key).FirstOrDefault().Value;
    DateTime tafReportUtc;
    DateTime tafFetchUtc;
    TimeSpan tafReportAge = TimeSpan.Zero;
    TimeSpan tafFetchDiff = TimeSpan.Zero;
	bool tafIsAmd = false; // TAF AMD flag

    if (latestTaf != null)
    {
        tafReportUtc = DateTime.SpecifyKind(latestTaf.reportTime, DateTimeKind.Utc);
        tafFetchUtc = DateTime.SpecifyKind(latestTaf.fetchTime, DateTimeKind.Utc);
		tafIsAmd = latestTaf.decodedTaf.Type == DecodedTaf.TafType.TAFAMD;
        tafReportAge = nowClock - tafReportUtc.TimeOfDay;
        tafFetchDiff = tafFetchUtc.TimeOfDay - tafReportUtc.TimeOfDay;
        
    }
    else
    {
		tafReportUtc = DateTime.MinValue; // eller en anden passende værdi
		tafFetchUtc = DateTime.MinValue; // eller en anden passende værdi
    }

    var icao = airport.getAirportInfo().icaoId;

    // metarTime/tafTime er allerede normaliseret UTC
    bool metarIsNewForUser = latestMetar != null && ack.IsMetarNew(icao, metarReportUtc);
    bool tafIsNewForUser = latestTaf != null && ack.IsTafNew(icao, tafReportUtc);



    <div>
        <table class="table-parent">
            <thead>
                <tr>
                    <th></th>
                    <th>Station</th>
                    <th>Report type</th>
                    <th>Report time(age)</th>
                    <th>Fetch time(age)</th>
                    <th>Raw report</th>
                </tr>
            </thead>
            <tbody>
                @{
                    // afgør class til TAF-rækken
                    var tafRowClass =
                    (latestTaf != null && tafIsNewForUser && showNewTaf)
                    ? (tafIsAmd ? "blink-red" : "taf-new-report")
                    : "taf-old-report";
                }

                <tr class="@tafRowClass">
                    <td class="actions-cell" rowspan="2">
                        <button @onclick="() => ConfirmReports(airport)" title="Confirm reports">✔️</button>
                        <button @onclick="() => RemoveAirport(airport.getAirportInfo().icaoId)" title="Remove airport">❌</button>
                    </td>

                    <td class="station-cell" rowspan="2" @onclick="() => NavigateToAirportPage(airport.getAirportInfo().icaoId)">
                        <div style="display:flex;flex-direction:column;justify-content:space-between;height:100%;">
                            <div>@airport.getAirportInfo().icaoId</div>
                            <div class="station-city">@airport.getAirportInfo().country</div>
                        </div>
                    </td>

                    @if (latestTaf != null)
                    {
                        <td>TAF</td>
                        <td>@tafReportUtc.ToString("HH:mm") (@FormatTimeDiff(tafReportAge))</td>
                        <td>@tafFetchUtc.ToString("HH:mm") (@FormatTimeDiff(tafFetchDiff))</td>
                        <td>@latestTaf.decodedTaf?.RawTaf</td>
                    }
                    else
                    {
                        <td>TAF</td>
                        <td>NO TAF</td>
                        <td>NO TAF</td>
                        <td>NO TAF</td>
                    }
                </tr>


                <tr>
                    @if (latestMetar != null)
                    {
                        <td class="report-type-cell @((metarIsNewForUser && showNewMetar ? "metar-new-report" : "metar-old-report"))">
                            METAR
                        </td>
                        <td class="reports-time-cell @((metarIsNewForUser && showNewMetar ? "metar-new-report" : "metar-old-report"))">
                            @metarReportUtc.ToString("HH:mm") (@FormatTimeDiff(metarReportAge))
                        </td>
                        <td class="reports-time-cell @((metarIsNewForUser && showNewMetar ? "metar-new-report" : "metar-old-report"))">
                            @metarFetchUtc.ToString("HH:mm") (@FormatTimeDiff(metarFetchDiff))
                        </td>
                        <td class="@((metarIsNewForUser && showNewMetar ? "metar-new-report" : "metar-old-report"))">
                            @latestMetar.decodedMetar?.RawMetar
                        </td>
                    }
                    else
                    {
                        <td class="metar-old-report">METAR</td>
                        <td class="metar-old-report">NO METAR</td>
                        <td class="metar-old-report">NO METAR</td>
                        <td class="metar-old-report">NO METAR</td>
                    }
                </tr>
            </tbody>
        </table>
    </div>
}



